{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "server",
  "entrypoints": {
    "dedicated-server": [
      "m6fgr.latency_updater.LatencyUpdaterFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "betterpingdisplay": "*"
  }
}